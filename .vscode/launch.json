{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start",
            "type": "debugpy",
            "request": "launch",
            "program": "app/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--configuration_file_path",
                "configuration_files/configuration_file.yml"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
    ]
}
